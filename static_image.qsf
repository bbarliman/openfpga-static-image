# --- Video Red Bus ---
set_location_assignment PIN_H18 -to video_r_0
set_location_assignment PIN_A17 -to video_r_1
set_location_assignment PIN_B17 -to video_r_2
set_location_assignment PIN_C18 -to video_r_3
set_location_assignment PIN_D18 -to video_r_4
set_location_assignment PIN_E18 -to video_r_5
set_location_assignment PIN_G17 -to video_r_6
set_location_assignment PIN_G18 -to video_r_7

# --- Video Green Bus ---
set_location_assignment PIN_H15 -to video_g_0
set_location_assignment PIN_B16 -to video_g_1
set_location_assignment PIN_C16 -to video_g_2
set_location_assignment PIN_D16 -to video_g_3
set_location_assignment PIN_E16 -to video_g_4
set_location_assignment PIN_F16 -to video_g_5
set_location_assignment PIN_G16 -to video_g_6
set_location_assignment PIN_G15 -to video_g_7

# --- Video Blue Bus ---
set_location_assignment PIN_A13 -to video_b_0
set_location_assignment PIN_B13 -to video_b_1
set_location_assignment PIN_C13 -to video_b_2
set_location_assignment PIN_D13 -to video_b_3
set_location_assignment PIN_E13 -to video_b_4
set_location_assignment PIN_F13 -to video_b_5
set_location_assignment PIN_G13 -to video_b_6
set_location_assignment PIN_H13 -to video_b_7

# --- RAM Data Bus ---
set_location_assignment PIN_C2  -to sram_data_0
set_location_assignment PIN_C1  -to sram_data_1
set_location_assignment PIN_D2  -to sram_data_2
set_location_assignment PIN_D1  -to sram_data_3
set_location_assignment PIN_E1  -to sram_data_4
set_location_assignment PIN_F2  -to sram_data_5
set_location_assignment PIN_F1  -to sram_data_6
set_location_assignment PIN_H1  -to sram_data_7
set_location_assignment PIN_Y2  -to sram_data_8
set_location_assignment PIN_Y1  -to sram_data_9
set_location_assignment PIN_AA2 -to sram_data_10
set_location_assignment PIN_AA1 -to sram_data_11
set_location_assignment PIN_AB2 -to sram_data_12
set_location_assignment PIN_AB1 -to sram_data_13
set_location_assignment PIN_AC2 -to sram_data_14
